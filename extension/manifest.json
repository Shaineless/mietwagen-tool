{
  "manifest_version": 3,
  "name": "Mietwagen-Preistool. Preisleser",
  "version": "1.0.0",
  "description": "Liest Preise aus geöffneten Mietwagen-Trefferlisten und reicht sie an das lokal laufende Mietwagen-Preistool weiter.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*.sixt.de/*",
    "*://*.sixt.at/*",
    "*://*.sixt.ch/*",
    "*://*.sixt.nl/*",
    "*://*.sixt.be/*",
    "*://*.sixt.lu/*",
    "*://*.sixt.fr/*",
    "*://*.sixt.es/*",
    "*://*.sixt.it/*",
    "*://*.sixt.pt/*",
    "*://*.sixt.co.uk/*",
    "*://*.sixt.ie/*",
    "*://*.sixt.dk/*",
    "*://*.sixt.se/*",
    "*://*.sixt.no/*",
    "*://*.sixt.fi/*",
    "*://*.sixt.pl/*",
    "*://*.sixt.cz/*",
    "*://*.sixt.hu/*",
    "*://*.sixt.hr/*",
    "*://*.sixt.gr/*",
    "*://*.sixt.com.tr/*",
    "*://*.sixt.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.sixt.de/*",
        "*://*.sixt.at/*",
        "*://*.sixt.ch/*",
        "*://*.sixt.nl/*",
        "*://*.sixt.be/*",
        "*://*.sixt.lu/*",
        "*://*.sixt.fr/*",
        "*://*.sixt.es/*",
        "*://*.sixt.it/*",
        "*://*.sixt.pt/*",
        "*://*.sixt.co.uk/*",
        "*://*.sixt.ie/*",
        "*://*.sixt.dk/*",
        "*://*.sixt.se/*",
        "*://*.sixt.no/*",
        "*://*.sixt.fi/*",
        "*://*.sixt.pl/*",
        "*://*.sixt.cz/*",
        "*://*.sixt.hu/*",
        "*://*.sixt.hr/*",
        "*://*.sixt.gr/*",
        "*://*.sixt.com.tr/*",
        "*://*.sixt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
