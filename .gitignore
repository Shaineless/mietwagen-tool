node_modules/
tools/_probe*

# Der Projektstand vor dem Redesign. Bleibt auf der Platte, gehoert aber nicht
# ins Repo: ein zweiter halber Quellbaum verwirrt jeden, der hineinschaut.
alt/

# Oertliche Werkzeug- und Editoreinstellungen — auf jedem Rechner andere.
.claude/
.vscode/
.idea/

# Betriebsdaten, keine Quellen: entstehen beim Benutzen und sind auf jedem
# Rechner andere. Der ACRISS-Katalog bleibt bewusst drin — er ist mühsam
# gesammeltes Wissen darüber, welche Klassen es wo gibt.
data/preisverlauf.jsonl
data/preisverlauf-*.jsonl
data/wecker.json
data/einstellungen.json
data/tracker.log

# Zwischenstufen und Ergebnis des EXE-Baus. Die EXE ist knapp 100 MB, weil
# die Node-Laufzeit darin steckt — sie gehört nicht in die Versionsverwaltung,
# sondern zu den Veröffentlichungen.
build/
dist/*.exe
dist/Tracker-Daten/
data/verbesserungen.jsonl

# Proxy-Zugangsdaten und Verbrauch: Betriebsdaten, keine Quellen.
data/proxies.json
data/proxy-verbrauch.json
